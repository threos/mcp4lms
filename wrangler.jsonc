{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp4lms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Console logs only. Request (invocation) logs are off: they would record download-link
  // URLs, which carry the link's secret, and students' IPs and user agents.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // No *.workers.dev URL or per-version preview URLs: the custom domain below is the only
  // way in. Preview versions would run unreleased code against production D1/KV.
  "workers_dev": false,
  "preview_urls": false,

  // Static files (logo, favicon). Served before the Worker for matching paths.
  "assets": { "directory": "./public" },

  // One deployment serves one LMS. Change these for your own instance.
  "vars": {
    "PUBLIC_URL": "https://mcp4lms.com",
    "LMS_URL": "https://lms.ozyegin.edu.tr",
    "REPO_URL": "https://github.com/threos/mcp4lms"
  },

  // OAuth grants/tokens (managed by @cloudflare/workers-oauth-provider).
  // Create with: npx wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "9301f1daa3e94e3085407f2fff1928c5" }],

  // Accounts (encrypted LMS tokens). Create with: npx wrangler d1 create mcp4lms
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp4lms",
      "database_id": "73c7fe93-92f2-4ef8-8753-c88bc3e91760",
      "migrations_dir": "migrations"
    }
  ],

  // Production hostname (Cloudflare issues the certificate). Must match PUBLIC_URL.
  // www is attached too, only so the Worker can redirect it to the apex (see src/index.ts).
  "routes": [
    { "pattern": "mcp4lms.com", "custom_domain": true },
    { "pattern": "www.mcp4lms.com", "custom_domain": true }
  ],

  // Per-IP rate limits (see src/ratelimit.ts). period is 10 or 60 seconds; namespace_id is any
  // integer that is unique within the Cloudflare account.
  "ratelimits": [
    { "name": "RL_CONNECT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_REGISTER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_TOKEN", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_KEY", "namespace_id": "4104", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_DOWNLOAD", "namespace_id": "4105", "simple": { "limit": 30, "period": 60 } }
  ],

  // Hourly cleanup of expired OAuth records, accounts and download links.
  "triggers": { "crons": ["17 * * * *"] }
}
